# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Где хранить выбранные пользователями группы (необязательно)
DB_PATH=data/bot.db

# Telegram ID админов через запятую: им доступны /stats и /broadcast
# (свой ID можно узнать, отправив боту /stats, — он появится в логе)
ADMIN_IDS=
